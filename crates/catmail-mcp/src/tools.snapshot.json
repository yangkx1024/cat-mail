[
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "The mail accounts: their ids, addresses, and how much is unread, drafted and waiting to be sent.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "name": "list_accounts",
    "outputSchema": {
      "$defs": {
        "AccountOut": {
          "properties": {
            "drafts": {
              "description": "Drafts not handed to \"send\".",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "email": {
              "type": "string"
            },
            "id": {
              "format": "int64",
              "type": "integer"
            },
            "inbox_unread": {
              "description": "Unread messages in its INBOX.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "description": "`gmail` when its folders other than All Mail, Trash and Spam are labels;\n`standard`; null before the first sync.",
              "type": [
                "string",
                "null"
              ]
            },
            "outbox": {
              "description": "Messages handed to \"send\" that aren't sent yet.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "sends_as": {
              "description": "The addresses it sends as, the default first.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "id",
            "email",
            "sends_as",
            "mode",
            "inbox_unread",
            "drafts",
            "outbox"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountOut"
          },
          "type": "array"
        }
      },
      "required": [
        "accounts"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Drafts not handed to \"send\" yet, newest first.",
