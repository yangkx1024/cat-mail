  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Fetches new mail and changes from the servers now, rather than at the next background sync, and reports what changed. Changes made here that are waiting go to the server first.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "account": {
          "description": "Only this account (id, from `list_accounts`); every account if left out.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "sync",
    "outputSchema": {
      "$defs": {
        "AccountSynced": {
          "properties": {
            "account": {
              "format": "int64",
              "type": "integer"
            },
            "email": {
              "type": "string"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ErrorOut"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Why the account didn't sync; null if it did."
            },
            "folders": {
              "description": "The folders where something changed or went wrong.",
              "items": {
                "$ref": "#/$defs/FolderSynced"
              },
              "type": "array"
            }
          },
          "required": [
            "account",
            "email",
            "error",
            "folders"
          ],
          "type": "object"
        },
        "ErrorOut": {
          "properties": {
            "kind": {
              "description": "`network`, `auth`, `over_limit`, `refused`, `out_of_sync`, `not_found`,\n`invalid`, `conflict`, `internal`.",
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        "FolderSynced": {
          "properties": {
            "added": {
              "description": "New messages.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "changes_applied": {
              "description": "Changes made here that reached the server first.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "changes_refused": {
              "description": "Changes made here that the server refused: they were undone here.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ErrorOut"
                },
                {
                  "type": "null"
                }
              ]
            },
            "folder": {
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "removed": {
              "description": "Messages gone from the server.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "updated": {
              "description": "Messages whose flags changed.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "folder",
            "name",
            "added",
            "updated",
            "removed",
            "changes_applied",
            "changes_refused",
            "error"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountSynced"
          },
          "type": "array"
        }
      },
      "required": [
        "accounts"
      ],
      "type": "object"
    }
  }
