          ]
        },
        "from": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "has_attachments": {
          "type": "boolean"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "labels": {
          "description": "On Gmail, its labels.",
