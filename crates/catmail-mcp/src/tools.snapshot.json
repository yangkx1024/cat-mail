            },
            "attachments": {
              "description": "File names.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "bcc": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "cc": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "id": {
              "format": "int64",
              "type": "integer"
            },
            "replying_to": {
              "description": "The message it replies to.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "subject": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "to": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "updated_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
