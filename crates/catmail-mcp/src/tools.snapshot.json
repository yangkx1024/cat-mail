            "updated_at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "drafts": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/DraftOut"
          },
          "type": "array"
