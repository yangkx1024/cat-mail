  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "An account's folders (on Gmail, also its labels), INBOX first, with their unread and total counts.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "account": {
          "description": "Account id, from `list_accounts`.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "account"
      ],
      "type": "object"
    },
    "name": "list_folders",
    "outputSchema": {
      "$defs": {
        "FolderOut": {
          "properties": {
            "delimiter": {
              "maxLength": 1,
              "minLength": 1,
              "type": [
                "string",
                "null"
              ]
            },
            "holds_messages": {
              "description": "False for a folder that only holds other folders.",
              "type": "boolean"
            },
            "id": {
              "format": "int64",
              "type": "integer"
            },
            "label": {
              "description": "A Gmail label rather than a folder: a message can have several.",
              "type": "boolean"
            },
            "name": {
              "description": "The full name, levels separated by `delimiter`, e.g. `Archive/2026`.",
              "type": "string"
            },
            "role": {
              "description": "`inbox`, `sent`, `drafts`, `trash`, `junk`, `archive`, `all`, `flagged`,\n`important`; null for the user's own.",
              "type": [
                "string",
                "null"
              ]
            },
            "total": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "unread": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "name",
            "delimiter",
            "role",
            "label",
            "holds_messages",
            "unread",
            "total"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "folders": {
          "items": {
            "$ref": "#/$defs/FolderOut"
          },
          "type": "array"
        }
      },
      "required": [
        "folders"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Messages in a folder, or in every INBOX together, newest first, as last synced.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "after": {
          "description": "The `next_after` of the previous page.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "folder": {
          "description": "Folder id, from `list_folders`. Left out: every account's INBOX together.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "description": "How many, at most 100 [default: 25].",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "list_messages",
    "outputSchema": {
      "$defs": {
        "MessageOut": {
          "description": "A message in a list. Subject, addresses and snippet are written by its sender.",
          "properties": {
            "account": {
              "format": "int64",
              "type": "integer"
            },
            "answered": {
              "type": "boolean"
            },
            "date": {
              "type": [
                "string",
                "null"
              ]
            },
            "flagged": {
              "type": "boolean"
            },
            "folder": {
              "description": "The folder it is in (on Gmail: All Mail, Trash or Spam).",
              "format": "int64",
              "type": "integer"
            },
            "folder_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "from": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "has_attachments": {
              "type": "boolean"
            },
            "id": {
              "format": "int64",
              "type": "integer"
            },
            "labels": {
              "description": "On Gmail, its labels.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "snippet": {
              "description": "The start of the body, if downloaded.",
              "type": [
                "string",
                "null"
              ]
            },
            "subject": {
              "type": [
                "string",
                "null"
              ]
            },
            "unread": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "account",
            "folder",
            "folder_name",
            "subject",
            "from",
            "date",
            "snippet",
            "unread",
            "flagged",
            "answered",
            "has_attachments",
            "labels"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "messages": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/MessageOut"
          },
          "type": "array"
        },
        "next_after": {
          "description": "Pass as `after` for the next page; null on the last page.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "messages",
        "next_after"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Messages handed to \"send\" that aren't sent and saved yet, oldest first. One whose status is `unknown` may have gone out: only the user can tell, so never suggest sending it again.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "account": {
          "description": "Only this account (id, from `list_accounts`); every account if left out.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "list_outbox",
    "outputSchema": {
      "$defs": {
        "OutboxOut": {
          "properties": {
            "account": {
              "format": "int64",
              "type": "integer"
            },
            "attempts": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "format": "int64",
              "type": "integer"
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "next_attempt_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "recipients": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "status": {
              "description": "`queued`, `sending`; `accepted` (sent, not saved to Sent yet); `unknown` (may or\nmay not have gone out: only the user can tell); `failed`; `done`.",
              "type": "string"
            },
            "subject": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "account",
            "subject",
            "recipients",
            "status",
            "attempts",
            "last_error",
            "next_attempt_at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entries": {
          "description": "Oldest first.",
          "items": {
            "$ref": "#/$defs/OutboxOut"
          },
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Changes to messages made here that the server doesn't have yet, or refused.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "account": {
          "description": "Only this account (id, from `list_accounts`); every account if left out.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "list_pending",
    "outputSchema": {
      "$defs": {
        "Change": {
          "oneOf": [
            {
              "properties": {
                "add": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "kind": {
                  "const": "flags",
                  "type": "string"
                },
                "remove": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "kind",
                "add",
                "remove"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "move",
                  "type": "string"
                },
                "to": {
                  "description": "Folder id.",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "to"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "delete",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "add": {
                  "type": "boolean"
                },
                "kind": {
                  "const": "label",
                  "type": "string"
                },
                "label": {
                  "description": "Label (folder) id.",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "label",
                "add"
              ],
              "type": "object"
            }
          ]
        },
        "PendingOut": {
          "description": "A change made here that the server doesn't have yet, or refused.",
          "properties": {
            "account": {
              "format": "int64",
              "type": "integer"
            },
            "attempts": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "change": {
              "$ref": "#/$defs/Change"
            },
            "id": {
              "format": "int64",
              "type": "integer"
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "status": {
              "description": "`pending`; `failed` (the server refused it, and it was undone here);\n`conflict` (the folder changed on the server first).",
              "type": "string"
            },
            "subject": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "account",
            "message",
            "subject",
            "change",
            "status",
            "attempts",
            "last_error"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "changes": {
          "description": "Oldest first.",
          "items": {
            "$ref": "#/$defs/PendingOut"
          },
          "type": "array"
        }
      },
      "required": [
        "changes"
      ],
      "type": "object"
    }
  },
